# Copy to .env and fill in. Never commit .env. Values below are DEV placeholders.
# Production: see docs/production-deployment.md, then run `python3 scripts/preflight.py --compose` (prints names, never values).
APP_ENV=development          # production -> services refuse to start with dev login / simulator / unsigned webhooks / weak JWT secret
# --- Database (owner is used only by the migrator; services use the RLS-bound zuvo_app role)
POSTGRES_PASSWORD=change-me-owner
ZUVO_APP_DB_PASSWORD=change-me-app-8chars

# --- Auth
JWT_SECRET=generate-with-openssl-rand-hex-32
AUTH_DEV_LOGIN=true          # dev-only identity picker; must be false in production

# --- Gateway / Meta
META_VERIFY_TOKEN=
META_APP_SECRET=
REQUIRE_HMAC_VERIFICATION=true
ENABLE_SIMULATOR=true        # dev-only /messages/simulate-inbound

# --- Dispatch / Meta Cloud API
META_SYSTEM_USER_TOKEN=
META_DRY_RUN=true            # true = log outbound sends without calling Meta

# --- AI (Gemini Flash-Lite during testing)
GEMINI_API_KEY=
ZUVO_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_ATTEMPTS=3          # retries timeouts/429/5xx with 1s,2s backoff before flagging AI_PENDING

# --- Host ports (dev only; docker-compose.prod.yml publishes nothing except Caddy)
GATEWAY_PORT=8000
FRONTEND_PORT=3000

# --- Production edge (docker-compose.prod.yml + deploy/caddy/Caddyfile)
PUBLIC_DOMAIN=               # bare hostname, e.g. app.<your-domain>; DNS A record -> the VM's Elastic IP
ACME_EMAIL=                  # Let's Encrypt expiry notices
ALLOWED_ORIGINS=http://localhost:3000   # production: https://<PUBLIC_DOMAIN>
HTTP_PORT=80
HTTPS_PORT=443

# --- Corporate proxy (build + Gemini/Meta egress); leave empty if not needed
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Initial dashboard password for bundle workers with an email (only used when the user does not exist yet)
ZUVO_ONBOARD_DEFAULT_PASSWORD=change-me-now

# zuvo-ai-rag (internal retrieval service). Generate with: openssl rand -hex 32
RAG_SERVICE_TOKEN=
RAG_TIMEOUT_SECONDS=2

# Release identifier written to every log line as deployment_version (set by deploy scripts to the git sha)
ZUVO_VERSION=dev
