# ZuvoCloud production environment: TEMPLATE. Copy the values into SSM Parameter Store under /zuvo/prod/
# (SecureString for secrets) and render /opt/zuvo/.env with deploy/aws/render-env.sh. Never commit the real file.
# Every <...> is a placeholder; preflight refuses to deploy while any remain:
#   python3 scripts/preflight.py --env-file /opt/zuvo/.env --compose
#
# Generate secrets with: openssl rand -hex 32

# ---------------------------------------------------------------- deployment assumptions (all configurable)
APP_ENV=production
AWS_REGION=ap-south-1                         # also used by the awslogs override and the aws cli
PUBLIC_DOMAIN=<app.your-domain.in>            # bare hostname; DNS A record -> the instance's Elastic IP
ACME_EMAIL=<ops@your-domain.in>               # Let's Encrypt expiry notices
ALLOWED_ORIGINS=https://<app.your-domain.in>
HTTP_PORT=80
HTTPS_PORT=443
ZUVO_IMAGE_PREFIX=zuvo                        # local image names: zuvo/<service>:<IMAGE_TAG>
# IMAGE_TAG is set per release by scripts/deploy/deploy.sh (git commit); do not pin it here.
ZUVO_DATA_DIR=/data/zuvo                      # only with deploy/aws/docker-compose.datadir.yml (separate EBS volume)
BACKUP_DIR=/var/backups/zuvo
BACKUP_KEEP=14
BACKUP_S3_URI=s3://<zuvo-backups-ACCOUNT>/prod/db
BACKUP_KMS_KEY_ID=alias/zuvo-backup
LOG_RETENTION_DAYS=30                         # CloudWatch log groups /zuvo/* (only with the awslogs override)
HEALTH_URLS=https://<app.your-domain.in>/api/v1/health https://<app.your-domain.in>/
# alerting (deploy/ops/zuvo-watch.sh, docs/runbooks/README.md); at least one destination is required for alerts
ZUVO_ALERT_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:<ACCOUNT>:zuvo-alerts
# ZUVO_ALERT_WEBHOOK_URL comes from SSM (/zuvo/prod/ZUVO_ALERT_WEBHOOK_URL, SecureString) if used
BACKUP_MAX_AGE_HOURS=8
ZUVO_AI_DAILY_BUDGET_INR=50

# ---------------------------------------------------------------- database
POSTGRES_PASSWORD=<openssl rand -hex 32>
ZUVO_APP_DB_PASSWORD=<openssl rand -hex 32>

# ---------------------------------------------------------------- auth
JWT_SECRET=<openssl rand -hex 32>
AUTH_DEV_LOGIN=false
# Leave ZUVO_ONBOARD_DEFAULT_PASSWORD unset in production: issue per-user passwords instead.

# ---------------------------------------------------------------- WhatsApp / Meta
META_VERIFY_TOKEN=<openssl rand -hex 16>      # also entered in Meta App -> WhatsApp -> Configuration
META_APP_SECRET=<from Meta App -> Settings -> Basic>
META_SYSTEM_USER_TOKEN=<permanent system-user token>
META_DRY_RUN=false                            # true = log sends, do not call Meta (keep true until go-live)
REQUIRE_HMAC_VERIFICATION=true
ENABLE_SIMULATOR=false

# ---------------------------------------------------------------- AI
GEMINI_API_KEY=<from Google AI Studio / Vertex>
ZUVO_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_ATTEMPTS=3
RAG_SERVICE_TOKEN=<openssl rand -hex 32>
RAG_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------- egress proxy (normally empty on AWS)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
